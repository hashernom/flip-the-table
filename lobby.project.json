{
  "name": "flip-the-table-lobby",
  "globIgnorePaths": [
    "**/.gitkeep",
    "**/main.client.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "LightingStyle": "Realistic"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$className": "Folder",
        "Remotes": {
          "$path": "src/server/Remotes.luau"
        },
        "Lobby": {
          "$path": "src/server/lobby"
        }
      },
      "shared": {
        "$path": "src/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "shared": {
          "$path": "src/shared"
        },
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
