{
  "name": "flip-the-table",
  "globIgnorePaths": [
    "**/.gitkeep",
    "src/server/lobby/main.server.luau",
    "**/lobby.client.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "LightingStyle": "Realistic"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "shared": {
        "$path": "src/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        },
        "shared": {
          "$path": "src/shared"
        }
      }
    }
  }
}
